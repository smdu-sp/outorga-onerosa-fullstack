// ----------------------------------------------------------------------------
// 1) HISTÓRICO DE STATUS — necessário para série temporal e forecast
// ----------------------------------------------------------------------------
// Sem isso não dá pra saber QUANDO um processo mudou de status, só o estado
// atual. Toda análise de "taxa de quebra por mês" ou "tempo médio até quitação"
// depende disso.

enum StatusPagamento {
  EM_PAGAMENTO
  QUITADO
  QUEBRA
}

model HistoricoStatusProcesso {
  id           String          @id @default(uuid())
  processo_id  String
  processo     Processo        @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  status_anterior StatusPagamento?
  status_novo     StatusPagamento
  motivo          String?        @db.Text
  usuario_id      String?        // quem alterou (FK para Usuario, se aplicável)

  criado_em    DateTime        @default(now())

  @@index([processo_id])
  @@index([criado_em])
  @@map("historico_status_processo")
}

