// ----------------------------------------------------------------------------
// 4) LIGAR Sql (do Processo) com MonitoramentoLocalizacaoLote (da Ficha)
// ----------------------------------------------------------------------------
// Hoje setor/quadra/lote existem duplicados sem FK entre as duas tabelas.
// Se a ficha de monitoramento sempre corresponde a um SQL do processo,
// vale adicionar uma FK opcional para eliminar o join por texto:

model MonitoramentoLocalizacaoLote {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String             @unique
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  sql_id                 String?            // NOVO — referência direta ao Sql do processo
  sql                    Sql?               @relation(fields: [sql_id], references: [id])

  setor                  String?
  quadra                 String?
  lote_cadastrado        String?            @db.Text
  lote_atualizado        String?            @db.Text
  codigo_logradouro      String?

  @@index([sql_id])
  @@map("monitoramento_localizacao_lote")
}

