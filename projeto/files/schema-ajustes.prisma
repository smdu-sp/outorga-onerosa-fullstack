// Em código: sempre que status_pagamento mudar, gravar uma linha aqui
// (idealmente via trigger de banco ou middleware do Prisma, para garantir
// que nenhuma mudança passe sem registro).


// ----------------------------------------------------------------------------
// 2) JUROS/CORREÇÃO NA PARCELA — necessário para relatório de aging real
// ----------------------------------------------------------------------------

model Parcela {
  id                String    @id @default(uuid())
  num_parcela       Int
  valor             Float
  vencimento        DateTime  @db.Date
  data_quitacao     DateTime? @db.Date
  ano_pagamento     Int?
  cpf_cnpj          String?
  status_quitacao   Boolean   @default(false)
  antecipada        Boolean   @default(false)
  quebra            Boolean   @default(false)
  dias_antecipacao  Int?
  mes_competencia   String?
  mes_arrecadacao   String?

  // NOVOS CAMPOS:
  valor_juros       Decimal?  @db.Decimal(14, 2) // multa/juros aplicados no atraso
  valor_corrigido   Decimal?  @db.Decimal(14, 2) // valor final pago (valor + juros - eventuais descontos)
  dias_atraso       Int?      // calculável, mas materializar ajuda MUITO na query de aging

  criado_em         DateTime  @default(now())
  alterado_em       DateTime  @default(now()) @updatedAt

  processo_id       String
  processo          Processo  @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  @@index([vencimento])
  @@index([status_quitacao])
  @@index([processo_id])
  @@map("parcelas")
}


// ----------------------------------------------------------------------------
// 3) MIGRAR CAMPOS STRING → DECIMAL (MonitoramentoCalculoOutorga)
// ----------------------------------------------------------------------------
// Estes campos hoje são String (herança do import de planilha) e bloqueiam
// SUM/AVG/agregação numérica. Trocar tipo + rodar script de parse único.

model MonitoramentoCalculoOutorga {
  id                     String   @id @default(uuid())
  monitoramento_ficha_id String   @unique
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  fp_uso_r                Decimal? @db.Decimal(10, 4)   // era String
  fp_uso_nr                Decimal? @db.Decimal(10, 4)   // era String
  fs_uso_r                 Decimal? @db.Decimal(10, 4)   // era String
  fs_uso_nr                Decimal? @db.Decimal(10, 4)   // era String
  area_objeto_uso_r        Decimal? @db.Decimal(14, 2)   // era String
  area_objeto_uso_nr       Decimal? @db.Decimal(14, 2)   // era String
  area_total_objeto        Decimal? @db.Decimal(14, 2)   // era String
  area_nao_computavel           String?  @db.Text // mantém texto (campo composto/observação)
  area_nao_computavel_incidente String?  @db.Text
  area_nao_computavel_final     String?  @db.Text
  percentual_fachada_ativa Decimal? @db.Decimal(5, 2)    // era String
  area_computavel_total    Decimal? @db.Decimal(14, 2)
  area_construida_total    Decimal? @db.Decimal(14, 2)
  contrapartida_uso_r      Decimal? @db.Decimal(14, 2)   // era String — CRÍTICO p/ financeiro
  contrapartida_uso_nr     Decimal? @db.Decimal(14, 2)   // era String — CRÍTICO p/ financeiro
  contrapartida_total      Decimal? @db.Decimal(14, 2)   // era String — CRÍTICO p/ financeiro
  coeficiente_basico       Decimal? @db.Decimal(10, 4)
  coeficiente_utilizado    Decimal? @db.Decimal(10, 4)
  area_terreno             Decimal? @db.Decimal(14, 2)
  valor_m2_quadro14        Decimal? @db.Decimal(14, 2)
  area_fruicao_publica     Decimal? @db.Decimal(14, 2)
  area_doacao_melhoramento Decimal? @db.Decimal(14, 2)
  area_doacao_calcada      Decimal? @db.Decimal(14, 2)
  area_transferencia       Decimal? @db.Decimal(14, 2)
  area_habitacao_social    Decimal? @db.Decimal(14, 2)

  @@map("monitoramento_calculo_outorga")
}

