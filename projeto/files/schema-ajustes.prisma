// ----------------------------------------------------------------------------
// 6) CAMPO AGREGADO NO PROCESSO (opcional, mas ajuda MUITO no dashboard)
// ----------------------------------------------------------------------------
// Em vez de somar Parcela.valor toda vez, materializar (via trigger ou job):

model Processo {
  // ... campos existentes ...

  valor_total_parcelas   Decimal?  @db.Decimal(16, 2) // soma de todas as parcelas
  valor_total_pago       Decimal?  @db.Decimal(16, 2) // soma das parcelas quitadas
  valor_total_em_aberto  Decimal?  @db.Decimal(16, 2) // valor_total_parcelas - valor_total_pago

  @@map("processos")
}

