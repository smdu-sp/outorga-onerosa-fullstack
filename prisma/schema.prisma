generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Tipo {
  PDE
  COTA
  AIU
}

enum OrigemProcesso {
  APROVA_DIGITAL
  SEI
  SISACOE
  FISICO
  PORTAL
  SLCE
}

enum StatusPagamento {
  EM_PAGAMENTO
  QUITADO
  QUEBRA
}

model Usuario {
  id     String  @id @default(uuid())
  nome   String
  login  String  @unique
  email  String  @unique
  status Boolean @default(true)
  avatar String? @db.Text
  dev    Boolean @default(false)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  permissoes Permissao[]
  grupos     GrupoPermissao[]

  processos_criados       Processo[]                 @relation("ProcessoCriador")
  memoriais_oodc_criados  OodcMemorialCalculo[]      @relation("OodcMemorialCriador")
  planejamentos_criados   PlanejamentoOrcamentario[] @relation("PlanejamentoCriador")
  planejamentos_revisados PlanejamentoRevisao[]      @relation("PlanejamentoRevisor")

  // Gestão de Processos de Licenciamento
  processos_licenciamento_tecnico ProcessoLicenciamento[]     @relation("LicenciamentoTecnicoAtual")
  eventos_licenciamento           EventoLicenciamento[]       @relation("EventoLicenciamentoTecnico")
  distribuicoes_licenciamento     DistribuicaoLicenciamento[] @relation("DistribuicaoLicenciamentoTecnico")
  oficios_licenciamento           OficioLicenciamento[]       @relation("OficioLicenciamentoTecnico")
  auditorias_licenciamento        AuditoriaLicenciamento[]    @relation("AuditoriaLicenciamentoUsuario")

  @@map("usuarios")
}

model GrupoPermissao {
  id   String @id @default(uuid())
  nome String @unique

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  permissoes Permissao[]
  usuarios   Usuario[]

  @@map("grupos_permissoes")
}

model Permissao {
  id        String @id @default(uuid())
  nome      String
  permissao String @unique

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  usuarios Usuario[]
  grupos   GrupoPermissao[]

  @@map("permissoes")
}

model Processo {
  id               String          @id @default(uuid())
  tipo             Tipo?
  codigo           String?
  num_processo     String          @unique
  protocolo_ad     String?
  data_entrada     DateTime?       @db.Date
  data_autuacao    DateTime?       @db.Date
  status_pagamento StatusPagamento @default(EM_PAGAMENTO)
  origem           OrigemProcesso?

  // Interessado (requerente) e CNPJ/CPF da contrapartida — um por processo,
  // não por parcela (é a mesma pessoa/empresa pagando todas as parcelas).
  interessado String?
  cnpj        String?

  // SQL/INCRA bruto (inteiro/string da API) e formato cadastral SSS.QQQ.LLLL-D.
  sql_incra     String?
  sql_formatado String?

  // Total materializado = SUM(parcelas.valor). Fonte confiável da contrapartida
  // do processo (as parcelas são a verdade; contrapartida_total da planilha é
  // corrompida por escala). Mantido por prisma/backfill-totais.ts.
  valor_total_parcelas Decimal? @db.Decimal(16, 2)

  // Usuário que abriu o processo (criação ou importação). Usado para restringir
  // a visibilidade de quem não tem a permissão "processos_ver_todos" (ex.: Técnico).
  criado_por      String?
  usuario_criador Usuario? @relation("ProcessoCriador", fields: [criado_por], references: [id], onDelete: SetNull)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  parcelas           Parcela[]
  sqls               Sql[]
  multa              Multa?
  monitoramento      MonitoramentoFicha?
  monitoramento_cota MonitoramentoCotaSolidariedade?
  memoriais_oodc     OodcMemorialCalculo[]

  // Vínculo opcional com processo de licenciamento edilício (0..1)
  processo_licenciamento ProcessoLicenciamento?

  @@index([status_pagamento])
  @@index([tipo])
  @@index([origem])
  @@index([data_entrada])
  @@index([criado_por])
  @@map("processos")
}

/// Multa vinculada ao processo (1:1). Compõe a arrecadação do Fundurb quando quitada.
model Multa {
  id              String    @id @default(uuid())
  processo_id     String    @unique
  processo        Processo  @relation(fields: [processo_id], references: [id], onDelete: Cascade)
  valor           Decimal   @db.Decimal(16, 2)
  status_quitacao Boolean   @default(false)
  data_quitacao   DateTime? @db.Date

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  @@index([status_quitacao])
  @@map("multas")
}

/// SQL (Setor/Quadra/Lote) — cada processo pode ter um ou mais SQLs
model Sql {
  id          String   @id @default(uuid())
  processo_id String
  processo    Processo @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  setor             String?
  quadra            String?
  lote_cadastrado   String? @db.Text
  lote_atualizado   String? @db.Text
  codigo_logradouro String?

  coordenada_e Decimal? @db.Decimal(18, 11)
  coordenada_n Decimal? @db.Decimal(18, 11)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  enderecos SqlEndereco[]

  @@map("sqls")
}

/// Endereço associado a um SQL específico
model SqlEndereco {
  id     String @id @default(uuid())
  sql_id String
  sql    Sql    @relation(fields: [sql_id], references: [id], onDelete: Cascade)

  ordem  Int
  tipo   String?
  titulo String?
  nome   String? @db.Text
  numero String?

  @@unique([sql_id, ordem])
  @@map("sql_enderecos")
}

// --- Módulo monitoramento (planilha DEUSO – Outorga Onerosa) ---

enum IncidenciaCotaSolidariedade {
  SIM
  NAO
}

enum SituacaoMonitoramento {
  QUITADO
  ARRECADADO_AD
  EM_PAGAMENTO
  SEM_INFORMACAO
}

enum OrigemMonitoramento {
  SISACOE
  SEI
  APROVA_DIGITAL
  OUTRO
}

enum TipoLicencaMonitoramento {
  APROVACAO
  EXECUCAO
  CERTIFICADO_CONCLUSAO
}

enum ConstaDocumentoMonitoramento {
  CONSTA
  NAO_CONSTA
  NAO_SE_APLICA
}

/// Ficha única — planilha Cota de Solidariedade OODC (DEUSO), 1:1 com Processo
model MonitoramentoCotaSolidariedade {
  id          String   @id @default(uuid())
  processo_id String   @unique
  processo    Processo @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  ficha_ouc            Int? // OUC
  proposta_oodc        Int?
  data_informacao_dmus DateTime? @db.Date

  setor                    String?
  quadra                   String?
  lote                     String?  @db.Text
  lote_atualizado_sqcond   String?
  codigo_logradouro        String?
  endereco                 String?  @db.Text
  proprietario_interessado String?  @db.Text
  distrito                 String?
  subprefeitura            String?
  macrozona                String?  @db.Text
  macroarea                String?  @db.Text
  subsetor                 String?
  zona_uso                 String?
  subcategoria_uso         String?  @db.Text
  coeficiente_utilizado    Decimal? @db.Decimal(10, 4)
  area_terreno             Decimal? @db.Decimal(14, 2)
  valor_m2_quadro14        Decimal? @db.Decimal(14, 2)

  alvara_aprovacao      String?              @db.Text
  alvara_execucao       String?              @db.Text
  certificado_conclusao String?              @db.Text
  observacao            String?              @db.Text
  origem                OrigemMonitoramento?

  area_habitacao_social       String? // "-" ou m² na planilha
  situacao_cota               String?  @db.Text
  modalidade                  String?
  unidades                    String?
  estimativa_deposito_fundurb Decimal? @db.Decimal(14, 2)
  valor_calculado_processo    Decimal? @db.Decimal(14, 2)
  valor_pago                  Decimal? @db.Decimal(14, 2)
  valor_devido                Decimal? @db.Decimal(14, 2)

  comprovantes_pagamento_prodam String?                       @db.Text
  planilha_calculo_cota         ConstaDocumentoMonitoramento?
  termo_compromisso_portaria    ConstaDocumentoMonitoramento?
  solicitacao_dsiz              String?                       @db.Text
  preenchimento_qgis            String?                       @db.Text
  observacoes                   String?                       @db.Text
  ficha_revisada_em             DateTime?                     @db.Date

  area_construida_computavel_total Decimal? @db.Decimal(14, 2) // aba Ext. info

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  @@map("monitoramento_cota_solidariedade")
}

/// Ficha raiz de monitoramento (1:1 com Processo)
model MonitoramentoFicha {
  id          String   @id @default(uuid())
  processo_id String   @unique
  processo    Processo @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  // Bloco sem título na linha 4 — dados do processo / controle DEUSO
  responsavel_preenchimento String? // CD_RSP_OO
  proposta_oodc_id          String? // ID_OO
  numero_proposta           String? // NU_PPT_OO
  processo_modificativo     String? @db.Text // PRC_MDF_OO
  proprietario_interessado  String? @db.Text // NM_PIN_OO

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  coordenada                MonitoramentoCoordenada?
  localizacao_lote          MonitoramentoLocalizacaoLote?
  enderecos                 MonitoramentoEndereco[]
  enquadramento_urbanistico MonitoramentoEnquadramentoUrbanistico?
  subcategorias_uso         MonitoramentoSubcategoriaUso?
  calculo_outorga           MonitoramentoCalculoOutorga?
  situacao                  MonitoramentoSituacao?
  licencas                  MonitoramentoLicenca[]
  anotacoes_deuso           MonitoramentoAnotacaoDeuso?

  @@map("monitoramento_fichas")
}

/// Linha 4: Coordenada plana x / y
model MonitoramentoCoordenada {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String             @unique
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  coordenada_e Decimal? @db.Decimal(18, 11) // CRD_E
  coordenada_n Decimal? @db.Decimal(18, 11) // CRD_N

  @@map("monitoramento_coordenadas")
}

/// Setor, quadra, lote (rótulos linha 5; sem título na linha 4)
model MonitoramentoLocalizacaoLote {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String             @unique
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  setor             String? // CD_SET_OO
  quadra            String? // CD_QDR_OO
  lote_cadastrado   String? @db.Text // CD_LT_OO + CD_DL_OO
  lote_atualizado   String? @db.Text // CD_CM_OO
  codigo_logradouro String? // CD_LG_OO

  @@map("monitoramento_localizacao_lote")
}

/// Linha 4: ENDEREÇO 1 / ENDEREÇO 2 (1 ou mais)
model MonitoramentoEndereco {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  ordem  Int // 1 = ENDEREÇO 1, 2 = ENDEREÇO 2
  tipo   String? // TXT_ETP_OO / TXT_ETP2_OO
  titulo String? // TXT_ETT_OO / TXT_ETT2_OO
  nome   String? @db.Text // TXT_E1_OO / TXT_E2_OO
  numero String? // TXT_N1_OO / TXT_N2_OO

  @@unique([monitoramento_ficha_id, ordem])
  @@map("monitoramento_enderecos")
}

/// Distrito, macrozonas, zonas de uso, tipologia OODC (bloco da imagem)
model MonitoramentoEnquadramentoUrbanistico {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String             @unique
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  distrito                String? // SGL_DS_OO
  subprefeitura           String? // SGL_SB_OO
  macrozona               String? @db.Text // TXT_MZ_OO
  macroarea               String? @db.Text // TXT_MA_OO
  subsetor                String? // TXT_SST_OO
  intervencao_urbanistica String? // AIUSC quando dentro do perímetro da AIU Setor Central (Lei 17.844/22)
  intervencao_setor       String? @db.Text // tx_tipo_perimetro da camada geoportal:perimetro_aiu
  zona_uso_1_18081        String? // SGL_ZN1_OO
  zona_uso_2_17975        String? // SGL_ZN2_OO
  zona_uso_3_16402        String? // SGL_ZN3_OO
  zona_uso_4_16050        String? // SGL_ZN4_OO
  zona_uso_5_13885        String? // SGL_ZN5_OO
  zona_uso_6_13885        String? // SGL_ZN6_OO
  tipologia_uso_oodc      String? // CD_TUI1_OO
  uso                     String? @db.Text

  @@index([subprefeitura])
  @@index([distrito])
  @@map("monitoramento_enquadramento_urbanistico")
}

/// Linha 4: SUBCATEGORIA DE USO (R/HMP/HIS e nR)
model MonitoramentoSubcategoriaUso {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String             @unique
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  uso_r_hmp_his   String? @db.Text // SLG_SC1_OO
  uso_r_hmp_his_2 String? // SLG_SC2_OO
  uso_r_hmp_his_3 String? // SLG_SC3_OO
  uso_nr          String? @db.Text // SLG_SC4_OO
  uso_nr_2        String? // SLG_SC5_OO
  uso_nr_3        String? // SLG_SC6_OO
  uso_extra       String? // SLG_SC7_OO (coluna duplicada na planilha)

  @@map("monitoramento_subcategorias_uso")
}

/// Linha 4: Fp / Fs / áreas / contrapartida / coeficientes (cálculo outorga)
model MonitoramentoCalculoOutorga {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String             @unique
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  fp_uso_r                      Decimal? @db.Decimal(10, 4) // VL_FP_OO
  fp_uso_nr                     Decimal? @db.Decimal(10, 4)
  fs_uso_r                      Decimal? @db.Decimal(10, 4) // VL_FS_OO
  fs_uso_nr                     Decimal? @db.Decimal(10, 4)
  area_objeto_uso_r             Decimal? @db.Decimal(14, 2)
  area_objeto_uso_nr            Decimal? @db.Decimal(14, 2)
  area_total_objeto             Decimal? @db.Decimal(14, 2)
  area_nao_computavel           String?  @db.Text // AR_CNC_OO
  area_nao_computavel_incidente String?  @db.Text // AR_CNCI_OO
  area_nao_computavel_final     String?  @db.Text // AR_CNCF_OO
  percentual_fachada_ativa      Decimal? @db.Decimal(5, 2) // FA_ARNC_OO
  area_computavel_total         Decimal? @db.Decimal(14, 2) // AR_CPT_OO
  area_construida_total         Decimal? @db.Decimal(14, 2) // AR_CNT_OO
  contrapartida_uso_r           Decimal? @db.Decimal(14, 2) // VL_CNT_OO
  contrapartida_uso_nr          Decimal? @db.Decimal(14, 2)
  contrapartida_total           Decimal? @db.Decimal(14, 2)
  coeficiente_basico            Decimal? @db.Decimal(10, 4) // CA_BSC_OO
  coeficiente_utilizado         Decimal? @db.Decimal(10, 4) // CA_UTL_OO
  area_terreno                  Decimal? @db.Decimal(14, 2) // AR_ LT_OO
  valor_m2_quadro14             Decimal? @db.Decimal(14, 2) // VL_Q14_OO
  area_fruicao_publica          Decimal? @db.Decimal(14, 2) // AR_AFP_OO
  area_doacao_melhoramento      Decimal? @db.Decimal(14, 2) // AR_DMP_OO
  area_doacao_calcada           Decimal? @db.Decimal(14, 2) // AR_DCCD_OO
  area_transferencia            Decimal? @db.Decimal(14, 2) // AR_TRN_OO
  area_habitacao_social         Decimal? @db.Decimal(14, 2) // AR_HIS_OO

  @@map("monitoramento_calculo_outorga")
}

/// Incidência cota, situação AD, origem
model MonitoramentoSituacao {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String             @unique
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  incidencia_cota_solidariedade IncidenciaCotaSolidariedade? // ICD_CS_OO
  situacao                      SituacaoMonitoramento? // TXT_ST_OO
  origem                        OrigemMonitoramento? // ORGM_OO

  @@map("monitoramento_situacao")
}

/// Linha 4: Alvará aprovação / execução / certificado (1 registro por tipo)
model MonitoramentoLicenca {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  tipo           TipoLicencaMonitoramento
  numero         String?                  @db.Text // NU_ALVA_OO, NU_ALVE_OO, NU_ALVC_OO
  tipo_documento String? // TIPO_ALVA_OO, TIPO_ALVE_OO, TIPO_CTCC_OO
  data_expedicao DateTime?                @db.Date // DT_ALVA_OO, DT_ALVE_OO, DT_CNC_OO

  @@unique([monitoramento_ficha_id, tipo])
  @@map("monitoramento_licencas")
}

/// Observações e controle DEUSO (final da planilha)
model MonitoramentoAnotacaoDeuso {
  id                     String             @id @default(uuid())
  monitoramento_ficha_id String             @unique
  ficha                  MonitoramentoFicha @relation(fields: [monitoramento_ficha_id], references: [id], onDelete: Cascade)

  observacao_historico String?   @db.Text // OBS_01_00
  data_informacao_dmus DateTime? @db.Date // DT_INFO_OO
  solicitacao_dsiz     String?   @db.Text // OBS_02_OO
  preenchimento_qgis   String?   @db.Text // OBS_03_OO

  @@map("monitoramento_anotacoes_deuso")
}

model Parcela {
  id               String    @id @default(uuid())
  // Obrigação que esta parcela paga. Um mesmo processo pode ter OODC (PDE/AIU) E
  // Cota de Solidariedade (COTA) — obrigações independentes, cada uma parcelada.
  // O cálculo da Cota fica em MonitoramentoCotaSolidariedade.
  obrigacao        Tipo?
  num_parcela      Int
  valor            Float
  vencimento       DateTime  @db.Date
  data_quitacao    DateTime? @db.Date
  ano_pagamento    Int?
  cpf_cnpj         String?
  status_quitacao  Boolean   @default(false)
  antecipada       Boolean   @default(false)
  quebra           Boolean   @default(false)
  dias_antecipacao Int?
  mes_competencia  String?
  mes_arrecadacao  String?
  // anoEmissaoGuia  Int?
  // codSiglaUnidade String? SEL
  // codTipoServico  Int?
  // numGuia         Int?

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  processo_id String
  processo    Processo @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  @@index([vencimento])
  @@index([status_quitacao])
  @@index([processo_id, obrigacao])
  @@map("parcelas")
}

/// Coordenadorias de análise de licenciamento edilício.
enum CoordenadoriaAnalise {
  RESID
  SERVIN
  COMIN
  CAEPP
  PARHIS
}

enum StatusCicloLicenciamento {
  ATIVO
  ENCERRADO
}

enum TipoSistemaLicenciamento {
  SEI
  FISICO
  AD
}

enum CategoriaEventoLicenciamento {
  TECNICO
  ADMINISTRATIVO
  AUTOMATICO
}

enum TipoImovelLicenciamento {
  PRINCIPAL
  COMPLEMENTAR
}

enum TipoDistribuicaoLicenciamento {
  DIRETORIA
  TECNICO
}

/// Cadastro auxiliar: divisão dentro da coordenadoria (ex.: DSIGP, DSIMP).
model DivisaoLicenciamento {
  id            String               @id @default(uuid())
  coordenadoria CoordenadoriaAnalise
  codigo        String
  nome          String?

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  processos ProcessoLicenciamento[]

  @@unique([coordenadoria, codigo])
  @@map("lic_divisoes")
}

model AssuntoLicenciamento {
  id            String                @id @default(uuid())
  coordenadoria CoordenadoriaAnalise?
  nome          String
  ativo         Boolean               @default(true)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  processos ProcessoLicenciamento[]

  @@index([coordenadoria])
  @@map("lic_assuntos")
}

model SituacaoLicenciamento {
  id            String                @id @default(uuid())
  coordenadoria CoordenadoriaAnalise?
  codigo        String
  nome          String
  encerra       Boolean               @default(false)
  ativo         Boolean               @default(true)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  processos ProcessoLicenciamento[]

  @@unique([coordenadoria, codigo])
  @@index([codigo])
  @@map("lic_situacoes")
}

model TipoEventoLicenciamento {
  id            String                       @id @default(uuid())
  coordenadoria CoordenadoriaAnalise?
  categoria     CategoriaEventoLicenciamento
  codigo        String
  nome          String
  ativo         Boolean                      @default(true)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  eventos EventoLicenciamento[]

  @@unique([coordenadoria, categoria, codigo])
  @@index([categoria])
  @@map("lic_tipos_evento")
}

/// Categorias de monitoramento (Hospital, CEU, SESC, TJ-SP…) — por coordenadoria.
model CategoriaLicenciamento {
  id            String               @id @default(uuid())
  coordenadoria CoordenadoriaAnalise
  codigo        String
  nome          String
  ativo         Boolean              @default(true)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  processos ProcessoLicenciamentoCategoria[]

  @@unique([coordenadoria, codigo])
  @@map("lic_categorias")
}

/// Processo de licenciamento edilício (tramitação). Distinto do Processo de Outorga.
model ProcessoLicenciamento {
  id String @id @default(uuid())

  coordenadoria CoordenadoriaAnalise
  status_ciclo  StatusCicloLicenciamento  @default(ATIVO)
  tipo_sistema  TipoSistemaLicenciamento?

  num_processo         String  @unique
  protocolo            String?
  prioritario          Boolean @default(false)
  processo_relacionado String?
  equipamento_publico  Boolean @default(false)
  instancia            String?
  observacao           String? @db.Text

  data_autuacao            DateTime? @db.Date
  data_envio_coordenadoria DateTime? @db.Date
  data_ult_dist_diretoria  DateTime? @db.Date
  data_ult_dist_tecnico    DateTime? @db.Date
  data_despacho_doc        DateTime? @db.Date

  area_terreno_m2            Decimal? @db.Decimal(16, 2)
  area_construcao_inicial_m2 Decimal? @db.Decimal(16, 2)
  area_construcao_final_m2   Decimal? @db.Decimal(16, 2)
  zona                       String?
  categoria_uso              String?
  descricao_uso              String?  @db.Text
  subprefeitura              String?
  base_legal_pde             String?
  base_legal_lpuos           String?
  base_legal_coe             String?
  legislacao_especifica      String?  @db.Text
  documento_referencia       String?

  divisao_id String?
  divisao    DivisaoLicenciamento? @relation(fields: [divisao_id], references: [id], onDelete: SetNull)

  assunto_id String?
  assunto    AssuntoLicenciamento? @relation(fields: [assunto_id], references: [id], onDelete: SetNull)

  situacao_id String?
  situacao    SituacaoLicenciamento? @relation(fields: [situacao_id], references: [id], onDelete: SetNull)

  tecnico_atual_id String?
  tecnico_atual    Usuario? @relation("LicenciamentoTecnicoAtual", fields: [tecnico_atual_id], references: [id], onDelete: SetNull)

  /// Vínculo opcional com o processo de Outorga Onerosa (quando houver OODC).
  processo_outorga_id String?   @unique
  processo_outorga    Processo? @relation(fields: [processo_outorga_id], references: [id], onDelete: SetNull)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  imoveis       ProcessoLicenciamentoImovel[]
  interessados  ProcessoLicenciamentoInteressado[]
  incidencias   ProcessoLicenciamentoIncidencia[]
  categorias    ProcessoLicenciamentoCategoria[]
  eventos       EventoLicenciamento[]
  distribuicoes DistribuicaoLicenciamento[]
  oficios       OficioLicenciamento[]
  arquivamento  ArquivamentoLicenciamento?
  auditorias    AuditoriaLicenciamento[]

  @@index([coordenadoria])
  @@index([status_ciclo])
  @@index([tipo_sistema])
  @@index([tecnico_atual_id])
  @@index([situacao_id])
  @@index([divisao_id])
  @@map("lic_processos")
}

model ProcessoLicenciamentoImovel {
  id          String                @id @default(uuid())
  processo_id String
  processo    ProcessoLicenciamento @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  tipo          TipoImovelLicenciamento @default(COMPLEMENTAR)
  identificador String?
  logradouro    String?                 @db.Text
  numero        String?
  complemento   String?
  cep           String?
  ordem         Int                     @default(0)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  @@index([processo_id])
  @@index([identificador])
  @@map("lic_processo_imoveis")
}

model ProcessoLicenciamentoInteressado {
  id          String                @id @default(uuid())
  processo_id String
  processo    ProcessoLicenciamento @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  nome         String
  cpf_cnpj     String?
  tipo_vinculo String  @default("PRINCIPAL")
  ordem        Int     @default(0)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  @@index([processo_id])
  @@index([nome])
  @@map("lic_processo_interessados")
