  tipo             String
  flag             Boolean   @default(false)
  valor            Decimal?  @db.Decimal(16, 2)
  data_doc         DateTime? @db.Date
  numero_documento String?
  observacao       String?   @db.Text

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  @@unique([processo_id, tipo])
  @@map("lic_processo_incidencias")
}

model ProcessoLicenciamentoCategoria {
  id           String                 @id @default(uuid())
  processo_id  String
  processo     ProcessoLicenciamento  @relation(fields: [processo_id], references: [id], onDelete: Cascade)
  categoria_id String
  categoria    CategoriaLicenciamento @relation(fields: [categoria_id], references: [id], onDelete: Cascade)

  criado_em DateTime @default(now())

  @@unique([processo_id, categoria_id])
  @@map("lic_processo_categorias")
}

model EventoLicenciamento {
  id          String                @id @default(uuid())
  processo_id String
  processo    ProcessoLicenciamento @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  categoria      CategoriaEventoLicenciamento
  tipo_evento_id String?
  tipo_evento    TipoEventoLicenciamento?     @relation(fields: [tipo_evento_id], references: [id], onDelete: SetNull)

  tecnico_id String?
  tecnico    Usuario? @relation("EventoLicenciamentoTecnico", fields: [tecnico_id], references: [id], onDelete: SetNull)

  data_inicio  DateTime? @db.Date
  data_termino DateTime? @db.Date
  descricao    String?   @db.Text
  observacao   String?   @db.Text

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  @@index([processo_id])
  @@index([tecnico_id])
  @@index([tipo_evento_id])
  @@index([data_inicio])
  @@map("lic_eventos")
