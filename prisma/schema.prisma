model DistribuicaoLicenciamento {
  id          String                @id @default(uuid())
  processo_id String
  processo    ProcessoLicenciamento @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  tipo       TipoDistribuicaoLicenciamento
  destino    String?
  tecnico_id String?
  tecnico    Usuario?                      @relation("DistribuicaoLicenciamentoTecnico", fields: [tecnico_id], references: [id], onDelete: SetNull)

  data_inicio DateTime? @db.Date
  data_fim    DateTime? @db.Date

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  @@index([processo_id])
  @@index([tecnico_id])
  @@map("lic_distribuicoes")
}

model OficioLicenciamento {
  id          String                @id @default(uuid())
  processo_id String
  processo    ProcessoLicenciamento @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  numero                    String
  data_email_enviado        DateTime? @db.Date
  data_recebimento_resposta DateTime? @db.Date
  data_encerramento         DateTime? @db.Date
  interessado_nome          String?
  observacao                String?   @db.Text

  tecnico_id String?
  tecnico    Usuario? @relation("OficioLicenciamentoTecnico", fields: [tecnico_id], references: [id], onDelete: SetNull)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  @@index([processo_id])
  @@index([numero])
  @@map("lic_oficios")
