model ArquivamentoLicenciamento {
  id          String                @id @default(uuid())
  processo_id String                @unique
  processo    ProcessoLicenciamento @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  situacao           String?
  local              String?
  container          String?
  caixa              String?
  posicao            String?
  quantidade_volumes Int?
  quantidade_caixas  Int?
  data_arquivamento  DateTime? @db.Date
  observacao         String?   @db.Text

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  @@index([container])
  @@map("lic_arquivamentos")
}

model AuditoriaLicenciamento {
  id          String                @id @default(uuid())
  processo_id String
  processo    ProcessoLicenciamento @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  usuario_id     String?
  usuario        Usuario? @relation("AuditoriaLicenciamentoUsuario", fields: [usuario_id], references: [id], onDelete: SetNull)
  tipo_alteracao String
  valor_anterior String?  @db.Text
  valor_novo     String?  @db.Text

  criado_em DateTime @default(now())

  @@index([processo_id])
  @@index([criado_em])
  @@map("lic_auditorias")
}

/// Valor de referência (R$/m²) da OODC por setor/quadra/codlog — origem: aba `v` da
/// planilha oficial oodc-prot-v1.1.0 (~180 mil linhas), importada por
/// prisma/import-oodc-valor-referencia.ts. Usada pelo módulo DEV de teste de
/// cálculo (lib/oodc) para achar o V_MÁXIMO de um cenário.
model OodcValorReferencia {
  id                   String   @id @default(uuid())
  setor                String
  quadra               String
  codlog               String
  valor                Decimal  @db.Decimal(14, 4)
  data_inicio_vigencia DateTime @db.Date

  criado_em DateTime @default(now())

  @@unique([setor, quadra, codlog, data_inicio_vigencia])
  @@index([setor, quadra, codlog])
  @@map("oodc_valores_referencia")
}

/// Memorial de cálculo da OODC gerado pela tela `processos/[id]/calculo-oodc`
/// (preenchimento automático a partir do GeoSampa/BI/banco + confirmação manual).
/// Um processo pode ter várias linhas (histórico); a mais recente (`criado_em`) é a
/// vigente. Espelha `EntradaCalculoOodc` + `ResultadoCalculoOodc` de `lib/oodc/tipos.ts`.
model OodcMemorialCalculo {
  id          String   @id @default(uuid())
  processo_id String
  processo    Processo @relation(fields: [processo_id], references: [id], onDelete: Cascade)

  id_assunto            Int
  id_legislacao         Int
  /// 'SUGERIDA' quando veio de `sugerirLegislacao` sem o usuário trocar; 'MANUAL' caso o usuário tenha escolhido/sobrescrito.
  legislacao_origem     String
  legislacao_observacao String? @db.Text
  id_macrozona          Int
  id_macroarea          Int
  id_zona               Int
  id_area_aiu           Int?

  area_res_fruicao_m2                 Decimal @db.Decimal(14, 2)
  base_legal_frui_id                  Int
  area_doacao_verde_m2                Decimal @db.Decimal(14, 2)
  area_doacao_melhoramento_m2         Decimal @db.Decimal(14, 2)
  base_legal_mel_id                   Int
  area_reserva_praca_m2               Decimal @db.Decimal(14, 2)
  area_doacao_calcada_m2              Decimal @db.Decimal(14, 2)
  base_legal_cal_id                   Int
  /// area_res_cal — fundamento legal fixo (art. 37 da Lei 18.081/2024), não entra na fórmula do benefício
  area_reserva_calcada_m2             Decimal @db.Decimal(14, 2)
  /// area_des_mel — dropdown próprio (reaproveita a tabela base_mel), não entra na fórmula do benefício
  area_desapropriacao_melhoramento_m2 Decimal @db.Decimal(14, 2)
  base_legal_des_mel_id               Int

  cota_parte_maxima_m2 Decimal @db.Decimal(14, 2)

  outorga_projeto_anterior_rs     Decimal @db.Decimal(14, 2)
  incentivo_certificacao_rs       Decimal @db.Decimal(14, 2)
  incentivo_cota_ambiental_rs     Decimal @db.Decimal(14, 2)
  outorga_projeto_modificativo_rs Decimal @db.Decimal(14, 2)
  outorga_apoio_urbano_sul_rs     Decimal @db.Decimal(14, 2)

  id_classificacao_empreendimento Int

  /// Confirmações manuais exigidas pela sugestão de legislação (não existem em nenhuma fonte).
  opcao_expressa_regime_novo Boolean @default(false)
  despacho_decisorio_emitido Boolean @default(false)

  data_referencia DateTime @db.Date

  v_max                     Decimal? @db.Decimal(14, 4)
  soma_terreno_m2           Decimal  @db.Decimal(14, 2)
  soma_computavel_m2        Decimal  @db.Decimal(14, 2)
  soma_tdc_m2               Decimal  @db.Decimal(14, 2)
  soma_outorga_adquirida_m2 Decimal  @db.Decimal(14, 2)
  soma_beneficio_m2         Decimal  @db.Decimal(14, 2)
  soma_outorga_m2           Decimal  @db.Decimal(14, 2)
  valor_total_bruto_rs      Decimal  @db.Decimal(14, 2)
  deducao_ehis_ezeis_rs     Decimal  @db.Decimal(14, 2)
  valor_total_recolhido_rs  Decimal  @db.Decimal(14, 2)
  valor_total_liquido_rs    Decimal  @db.Decimal(14, 2)
  dentro_da_vigencia        Boolean

  criado_por String?
  usuario    Usuario? @relation("OodcMemorialCriador", fields: [criado_por], references: [id], onDelete: SetNull)
  criado_em  DateTime @default(now())

  enderecos  OodcMemorialEndereco[]
  tipologias OodcMemorialTipologia[]

  @@index([processo_id])
  @@map("oodc_memorial_calculo")
}

/// Até 10 endereços (setor/quadra/codlog) usados na busca do V/V_MÁXIMO de um memorial.
model OodcMemorialEndereco {
  id          String              @id @default(uuid())
  memorial_id String
  memorial    OodcMemorialCalculo @relation(fields: [memorial_id], references: [id], onDelete: Cascade)

  ordem  Int
  setor  String
  quadra String
  codlog String

  valor_encontrado Decimal?  @db.Decimal(14, 4)
  data_vigencia    DateTime? @db.Date

  @@unique([memorial_id, ordem])
  @@map("oodc_memorial_enderecos")
}

/// Até 7 tipologias (entrada + resultado calculado) de um memorial.
model OodcMemorialTipologia {
  id          String              @id @default(uuid())
  memorial_id String
  memorial    OodcMemorialCalculo @relation(fields: [memorial_id], references: [id], onDelete: Cascade)

  ordem                Int
  id_tipologia         Int
  ca_basico            Decimal @db.Decimal(10, 4)
  ca_maximo            Decimal @db.Decimal(10, 4)
  terreno_m2           Decimal @db.Decimal(14, 2)
  computavel_m2        Decimal @db.Decimal(14, 2)
  tdc_m2               Decimal @db.Decimal(14, 2)
  outorga_adquirida_m2 Decimal @db.Decimal(14, 2)

  fp                Decimal @db.Decimal(10, 4)
  fs                Decimal @db.Decimal(10, 4)
  ca_adicional      Decimal @db.Decimal(10, 4)
  beneficio_m2      Decimal @db.Decimal(14, 2)
  objeto_outorga_m2 Decimal @db.Decimal(14, 2)
  c_rs_m2           Decimal @db.Decimal(14, 4)
  valor_rs          Decimal @db.Decimal(14, 2)

  @@unique([memorial_id, ordem])
  @@map("oodc_memorial_tipologias")
}

// --- Módulo de Planejamento Orçamentário ---

/// Planejamento orçamentário de um ano: valor anual (= soma dos 12 meses) projetado a
/// partir da média de arrecadação dos 3 anos anteriores + parâmetros de correção.
enum MetodoDistribuicaoPlanejamento {
  MEDIA_HISTORICA
  IGUAL
}

model PlanejamentoOrcamentario {
  id  String @id @default(uuid())
  ano Int    @unique

  media_base_3_anos   Decimal                        @db.Decimal(16, 2) // snapshot da média usada no cálculo (auditoria)
  valor_anual         Decimal                        @db.Decimal(16, 2) // sempre = soma de PlanejamentoOrcamentarioMes.valor
  metodo_distribuicao MetodoDistribuicaoPlanejamento @default(MEDIA_HISTORICA)

  criado_por      String?
  usuario_criador Usuario? @relation("PlanejamentoCriador", fields: [criado_por], references: [id], onDelete: SetNull)

  criado_em   DateTime @default(now())
  alterado_em DateTime @default(now()) @updatedAt

  parametros   PlanejamentoParametroCorrecao[]
  meses        PlanejamentoOrcamentarioMes[]
  historicoAno PlanejamentoHistoricoAno[]
  revisoes     PlanejamentoRevisao[]

  @@map("planejamento_orcamentario")
}

/// Fator de correção multiplicável (ex.: IPCA 4,5%) aplicado sobre a média dos 3 anos.
model PlanejamentoParametroCorrecao {
  id              String                   @id @default(uuid())
  planejamento_id String
  planejamento    PlanejamentoOrcamentario @relation(fields: [planejamento_id], references: [id], onDelete: Cascade)

  nome       String
  percentual Decimal @db.Decimal(7, 4) // 4.5000 = 4,5%
  ordem      Int     @default(0)

  @@map("planejamento_parametros_correcao")
}

/// Valor mensal (1 de 12) do planejamento — sugerido a partir da distribuição histórica,
/// editável manualmente pelo admin.
model PlanejamentoOrcamentarioMes {
  id              String                   @id @default(uuid())
  planejamento_id String
  planejamento    PlanejamentoOrcamentario @relation(fields: [planejamento_id], references: [id], onDelete: Cascade)

  mes                 Int // 1–12
  valor               Decimal @db.Decimal(16, 2)
  editado_manualmente Boolean @default(false)

  @@unique([planejamento_id, mes])
  @@map("planejamento_orcamentario_meses")
}

/// Override opcional do valor-base de um dos 3 anos usados no cálculo da média
/// histórica. Não altera a arrecadação real (Parcela/Multa) — só a base de cálculo
/// deste planejamento específico (golden rule do CLAUDE.md: nunca corromper dado real).
model PlanejamentoHistoricoAno {
  id              String                   @id @default(uuid())
  planejamento_id String
  planejamento    PlanejamentoOrcamentario @relation(fields: [planejamento_id], references: [id], onDelete: Cascade)

  ano            Int
  valor_real     Decimal  @db.Decimal(16, 2) // snapshot da arrecadação real no momento do cálculo
  valor_ajustado Decimal? @db.Decimal(16, 2) // override manual, se o usuário editou

  @@unique([planejamento_id, ano])
  @@map("planejamento_historico_ano")
}

/// Snapshot do estado anterior sempre que um plano já fechado (fora do prazo normal de
/// edição) é revisado por um DEV. Permite reconstruir a evolução do planejamento ao
/// longo do ano. O comparativo planejado x executado sempre usa a versão vigente.
model PlanejamentoRevisao {
  id              String                   @id @default(uuid())
  planejamento_id String
  planejamento    PlanejamentoOrcamentario @relation(fields: [planejamento_id], references: [id], onDelete: Cascade)

  motivo String @db.Text

  valor_anual_anterior         Decimal @db.Decimal(16, 2)
  valor_anual_novo             Decimal @db.Decimal(16, 2)
  snapshot_parametros_anterior Json
  snapshot_meses_anterior      Json
  snapshot_historico_anterior  Json

  revisado_por String?
  usuario      Usuario? @relation("PlanejamentoRevisor", fields: [revisado_por], references: [id], onDelete: SetNull)
  revisado_em  DateTime @default(now())

  @@map("planejamento_revisoes")
}

/// Singleton com a regra de prazo de edição do planejamento (dia/mês do "ano atual" até
/// quando o planejamento do "ano seguinte" pode ser editado por um admin comum).
/// Configurável só por usuário DEV — ver `requireDev()` em lib/auth/session.ts.
model ConfiguracaoPlanejamento {
  id         String @id @default(uuid())
  dia_limite Int // 1–31
  mes_limite Int // 1–12

  alterado_por String?
  alterado_em  DateTime @default(now()) @updatedAt

  @@map("configuracao_planejamento")
}
